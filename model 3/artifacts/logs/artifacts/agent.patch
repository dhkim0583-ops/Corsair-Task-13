+                fpath = os.path.join(recovered_dir, fname)
+                try:
+                    with open(fpath, "r", encoding="utf-8") as f:
+                        recs = json.load(f)
+                    for r in recs:
+                        tx_id = r.get("transaction_id")
+                        if tx_id:
+                            by_txid[tx_id] = r
+                except Exception:
+                    pass
+
+    integrated_count = 0
+    discarded_count = 0
+    lock_timeout = config.get("lock_timeout_sec", 60)
+
+    # Process DLQ files in sorted filename order
+    if os.path.exists(dlq_dir):
+        dlq_files = sorted(glob.glob(os.path.join(dlq_dir, "dlq_*.cctf")))
+        for dlq_path in dlq_files:
+            dlq_recs = process_scanner_file(dlq_path, config)
+            for r in dlq_recs:
+                tx_id = r.get("transaction_id")
+                if not tx_id:
+                    continue
+
+                if tx_id not in by_txid:
+                    by_txid[tx_id] = r
+                    integrated_count += 1
+                else:
+                    existing_ts = by_txid[tx_id].get("timestamp", 0)
+                    dlq_ts = r.get("timestamp", 0)
+                    drift = abs(dlq_ts - existing_ts)
+
+                    if drift <= lock_timeout:
+                        discarded_count += 1
+                    else:
+                        by_txid[tx_id] = r
+                        integrated_count += 1
+
+    all_combined_records = list(by_txid.values())
+    audit_dict = {
+        "integrated_dlq_records": integrated_count,
+        "discarded_duplicates": discarded_count
+    }
+
+    return all_combined_records, audit_dict
