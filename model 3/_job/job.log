Sending keys: ['cat << \'EOF\' > stages/replay.py\nimport os\nimport glob\nimport json\nfrom stages.recovery import process_scanner_file\n\ndef replay_dead_letters(recovered_dir: str, dlq_dir: str, config: dict) -> tuple:\n    """\n    Reconciles dead-letter log records with recovered records.\n    Filters out duplicates within lock timeout, returns consolidated list and audit info.\n    """\n    by_txid = {}\n\n    # Load base recovered records from recovered_<id>.json files\n    if os.path.exists(recovered_dir):\n        for fname in os.listdir(recovered_dir):\n            if fname.startswith("recovered_") and fname.endswith(".json"):\n                fpath = os.path.join(recovered_dir, fname)\n                try:\n                    with open(fpath, "r", encoding="utf-8") as f:\n                        recs = json.load(f)\n                    for r in recs:\n                        tx_id = r.get("transaction_id")\n                        if tx_id:\n                            by_txid[tx_id] = r\n                except Exception:\n                    pass\n\n    integrated_count = 0\n    discarded_count = 0\n    lock_timeout = config.get("lock_timeout_sec", 60)\n\n    # Process DLQ files in sorted filename order\n    if os.path.exists(dlq_dir):\n        dlq_files = sorted(glob.glob(os.path.join(dlq_dir, "dlq_*.cctf")))\n        for dlq_path in dlq_files:\n            dlq_recs = process_scanner_file(dlq_path, config)\n            for r in dlq_recs:\n                tx_id = r.get("transaction_id")\n                if not tx_id:\n                    continue\n\n                if tx_id not in by_txid:\n                    by_txid[tx_id] = r\n                    integrated_count += 1\n                else:\n                    existing_ts = by_txid[tx_id].get("timestamp", 0)\n                    dlq_ts = r.get("timestamp", 0)\n                    drift = abs(dlq_ts - existing_ts)\n\n                    if drift <= lock_timeout:\n                        discarded_count += 1\n                    else:\n                        by_txid[tx_id] = r\n                        integrated_count += 1\n\n    all_combined_records = list(by_txid.values())\n    audit_dict = {\n        "integrated_dlq_records": integrated_count,\n        "discarded_duplicates": discarded_count\n    }\n\n    return all_combined_records, audit_dict\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
