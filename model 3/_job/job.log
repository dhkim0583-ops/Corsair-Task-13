Sending keys: ['cat << \'EOF\' > stages/aggregation.py\nimport json\nfrom collections import defaultdict\nfrom stages.cctf_utils import decode_cctf_frames\n\ndef aggregate_metrics(metrics_file: str, config: dict) -> list:\n    """\n    Processes OpenTelemetry metrics, filters out non-whitelisted attributes,\n    and aggregates them into hourly windows.\n    """\n    frames = decode_cctf_frames(metrics_file)\n    metric_config = config.get("metric_config", {})\n    whitelisted_attrs = set(metric_config.get("whitelisted_attributes", []))\n    interval_hours = metric_config.get("aggregation_interval_hours", 1)\n    interval_sec = interval_hours * 3600\n\n    groups = defaultdict(list)\n    # Map group_key to (metric_name, bucket, filtered_attrs)\n    group_info = {}\n\n    for ver, ftype, seq, payload_bytes in frames:\n        if ftype != 2:  # METRIC frame\n            continue\n        try:\n            record = json.loads(payload_bytes.decode("utf-8"))\n        except Exception:\n            continue\n\n        metric_name = record.get("metric_name")\n        timestamp = record.get("timestamp")\n        value = record.get("value")\n\n        if metric_name is None or timestamp is None or value is None:\n            continue\n\n        attrs = record.get("attributes", {})\n        if not isinstance(attrs, dict):\n            attrs = {}\n\n        filtered_attrs = {k: v for k, v in attrs.items() if k in whitelisted_attrs}\n\n        bucket = timestamp - (timestamp % interval_sec)\n        attr_json = json.dumps(filtered_attrs, sort_keys=True)\n        key = (metric_name, bucket, attr_json)\n\n        groups[key].append(float(value))\n        if key not in group_info:\n            group_info[key] = (metric_name, bucket, filtered_attrs)\n\n    aggregated = []\n    for key, values in groups.items():\n        metric_name, bucket, filtered_attrs = group_info[key]\n        mean_val = round(sum(values) / len(values), 4)\n        aggregated.append({\n            "metric_name": metric_name,\n            "timestamp": bucket,\n            "value": mean_val,\n            "attributes": filtered_attrs\n        })\n\n    # Sort ascending by metric_name, then timestamp, then sort_keys JSON serialization of attributes\n    aggregated.sort(key=lambda x: (\n        x["metric_name"],\n        x["timestamp"],\n        json.dumps(x["attributes"], sort_keys=True)\n    ))\n\n    return aggregated\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
