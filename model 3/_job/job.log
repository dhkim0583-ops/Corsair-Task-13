Sending keys: ['cat << \'EOF\' > stages/cctf_utils.py\nimport os\nimport struct\nimport zlib\nimport json\n\nFRAME_HEADER_LEN = 10\nFRAME_TRAILER_LEN = 8\n\ndef decode_cctf_frames(file_path):\n    if not os.path.exists(file_path):\n        return []\n    with open(file_path, "rb") as f:\n        data = f.read()\n\n    pos = 0\n    chain = 0\n    frames = []\n\n    while pos < len(data):\n        if len(data) - pos < FRAME_HEADER_LEN:\n            break\n        magic, ver, ftype, seq, plen = struct.unpack(">2sBBIH", data[pos:pos+10])\n        if magic != b"CC":\n            break\n        if len(data) - pos < FRAME_HEADER_LEN + plen + FRAME_TRAILER_LEN:\n            break\n\n        payload_bytes = data[pos+10 : pos+10+plen]\n        crc_stored, chain_stored = struct.unpack(">II", data[pos+10+plen : pos+18+plen])\n\n        crc_calc = zlib.crc32(data[pos : pos+10+plen]) & 0xFFFFFFFF\n        if crc_stored != crc_calc:\n            break\n\n        chain_calc = zlib.crc32(struct.pack(">I", chain) + struct.pack(">I", crc_calc)) & 0xFFFFFFFF\n        if chain_stored != chain_calc:\n            break\n\n        chain = chain_calc\n        pos += FRAME_HEADER_LEN + plen + FRAME_TRAILER_LEN\n        frames.append((ver, ftype, seq, payload_bytes))\n\n    return frames\n\ndef migrate_record_schema(ver, record, config):\n    schema_versions = config.get("schema_versions", {})\n    ver_str = str(ver)\n    if ver_str in schema_versions:\n        info = schema_versions[ver_str]\n        temp_field = info.get("temperature_field")\n        scale = info.get("scale")\n        if temp_field in record:\n            val = record.pop(temp_field)\n            if scale in ("deci_celsius", "deci-celsius"):\n                val = val / 10.0\n            record["temperature_c"] = float(val)\n        elif "temperature_c" in record:\n            record["temperature_c"] = float(record["temperature_c"])\n    elif "temperature_c" in record:\n        record["temperature_c"] = float(record["temperature_c"])\n\n    return record\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
