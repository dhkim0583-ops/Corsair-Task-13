Sending keys: ['cat << \'EOF\' > stages/recovery.py\nimport os\nimport glob\nimport json\nfrom stages.cctf_utils import decode_cctf_frames, migrate_record_schema\n\ndef process_scanner_file(file_path, config):\n    frames = decode_cctf_frames(file_path)\n    pending = []\n    savepoints = {}\n    committed = []\n\n    for ver, ftype, seq, payload_bytes in frames:\n        if ftype == 1:  # TXN\n            try:\n                record = json.loads(payload_bytes.decode("utf-8"))\n            except Exception:\n                continue\n            record = migrate_record_schema(ver, record, config)\n            pending.append(record)\n        elif ftype == 5:  # SAVEPOINT\n            try:\n                data = json.loads(payload_bytes.decode("utf-8"))\n                sp_name = data.get("savepoint")\n                if sp_name:\n                    savepoints[sp_name] = len(pending)\n            except Exception:\n                pass\n        elif ftype == 6:  # ROLLBACK\n            try:\n                data = json.loads(payload_bytes.decode("utf-8"))\n                sp_name = data.get("savepoint")\n                if sp_name and sp_name in savepoints:\n                    target_idx = savepoints[sp_name]\n                    pending = pending[:target_idx]\n                    savepoints = {k: v for k, v in savepoints.items() if v <= target_idx}\n            except Exception:\n                pass\n        elif ftype == 3:  # COMMIT\n            committed.extend(pending)\n            pending = []\n            savepoints = {}\n        elif ftype == 4:  # ABORT\n            pending = []\n            savepoints = {}\n\n    return committed\n\ndef recover_ledgers(data_dir: str, output_dir: str, config: dict = None) -> dict:\n    """\n    Recovers scanner transaction ledgers from data_dir.\n    Handles partial writes (truncated CCTF files) and atomic-rename gaps.\n    Writes recovered files to output_dir and returns audit dictionary.\n    """\n    if config is None:\n        config_path = os.path.join(os.path.dirname(os.path.dirname(__file__)), "config", "pipeline_config.json")\n        if os.path.exists(config_path):\n            with open(config_path, "r", encoding="utf-8") as f:\n                config = json.load(f)\n        else:\n            config = {}\n\n    os.makedirs(output_dir, exist_ok=True)\n\n    # Find all scanner files\n    scanner_ids = set()\n    for fname in os.listdir(data_dir):\n        if fname.startswith("scanner_"):\n            if fname.endswith(".cctf.tmp"):\n                sid = fname[len("scanner_") : -len(".cctf.tmp")]\n                scanner_ids.add(sid)\n            elif fname.endswith(".cctf"):\n                sid = fname[len("scanner_") : -len(".cctf")]\n                scanner_ids.add(sid)\n\n    audit_recovery = {}\n\n    for sid in sorted(scanner_ids):\n        main_file = os.path.join(data_dir, f"scanner_{sid}.cctf")\n        tmp_file = os.path.join(data_dir, f"scanner_{sid}.cctf.tmp")\n\n        recs_main = process_scanner_file(main_file, config) if os.path.exists(main_file) else []\n        recs_tmp = process_scanner_file(tmp_file, config) if os.path.exists(tmp_file) else []\n\n        # Merge deduplicated: keep higher timestamp on duplicate transaction_id\n        tx_map = {}\n        for r in recs_main + recs_tmp:\n            tx_id = r.get("transaction_id")\n            if not tx_id:\n                continue\n            if tx_id not in tx_map:\n                tx_map[tx_id] = r\n            else:\n                if r.get("timestamp", 0) > tx_map[tx_id].get("timestamp", 0):\n                    tx_map[tx_id] = r\n\n        merged_records = list(tx_map.values())\n        merged_records.sort(key=lambda x: (x.get("sequence", 0), x.get("timestamp", 0), x.get("transaction_id", "")))\n\n        out_file = os.path.join(output_dir, f"recovered_{sid}.json")\n        with open(out_file, "w", encoding="utf-8") as f:\n            json.dump(merged_records, f, indent=2)\n\n        audit_recovery[sid] = len(merged_records)\n\n    audit_file = os.path.join(output_dir, "audit_recovery.json")\n    with open(audit_file, "w", encoding="utf-8") as f:\n        json.dump(audit_recovery, f, indent=2)\n\n    return audit_recovery\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
