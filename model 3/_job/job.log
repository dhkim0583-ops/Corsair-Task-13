Sending keys: ['python3 -c "\nimport os, json, shutil\nfrom stages.recovery import recover_ledgers\nfrom stages.consolidation import consolidate_and_checksum\n\ntest_dir = \'/tmp/golden_test\'\nif os.path.exists(test_dir):\n    shutil.rmtree(test_dir)\ndata_dir = os.path.join(test_dir, \'data\')\nout_dir = os.path.join(test_dir, \'out\')\nos.makedirs(data_dir)\n\n# Copy golden sample scanner\nshutil.copy(\'docs/golden/sample_scanner.cctf\', os.path.join(data_dir, \'scanner_g.cctf\'))\n\n# Run recovery\naudit = recover_ledgers(data_dir, out_dir)\nprint(\'Golden recovery audit:\', audit)\n\nwith open(os.path.join(out_dir, \'recovered_g.json\')) as f:\n    recovered = json.load(f)\n\nwith open(\'docs/golden/sample_recovered.json\') as f:\n    expected_recovered = json.load(f)\n\nprint(\'Recovered matches expected:\', recovered == expected_recovered)\nif recovered != expected_recovered:\n    print(\'Recovered:\', recovered)\n    print(\'Expected:\', expected_recovered)\n\n# Run consolidation\nroot_path = os.path.join(out_dir, \'root.bin\')\nsig_path = os.path.join(out_dir, \'sig.bin\')\nledger_path = os.path.join(out_dir, \'ledger.json\')\nroot_hex = consolidate_and_checksum(recovered, ledger_path, root_path, sig_path)\n\nwith open(root_path, \'rb\') as f:\n    root_bytes = f.read()\nwith open(sig_path, \'rb\') as f:\n    sig_bytes = f.read()\n\nwith open(\'docs/golden/sample_root.hex\') as f:\n    expected_root_hex = f.read().strip()\nwith open(\'docs/golden/sample_signature.hex\') as f:\n    expected_sig_hex = f.read().strip()\n\nprint(\'Root hex matches:\', root_hex == expected_root_hex)\nprint(\'Root bytes matches:\', root_bytes.hex() == expected_root_hex)\nprint(\'Sig bytes matches:\', sig_bytes.hex() == expected_sig_hex)\n"\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
