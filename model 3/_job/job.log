rgs.output_dir, "ledger_root.bin")\n    sig_path = os.path.join(args.output_dir, "ledger_signature.bin")\n    consolidate_and_checksum(\n        all_records=combined_records,\n        output_path=ledger_path,\n        root_path=root_path,\n        sig_path=sig_path\n    )\n\nif __name__ == "__main__":\n    main()\nEOF\nchmod +x recon_pipeline.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
