Running collect hook in service 'main': '# Where the artifacts go, and whether /logs is usable at all. A stale bind mount fails\n# at `mkdir` with "cannot stat", so the probe is a real write rather than a -d test.\nOUT=/logs/artifacts\nFALLBACK=0\nmkdir -p "$OUT" 2>/dev/null || true\n# Redirection before the target, so the probe\'s own failure message is swallowed.\n# Written the other way round, `>` is applied first and prints to the real stderr -\n# which harbor merges into stdout, putting noise ahead of the sentinels below.\nif ! : 2>/dev/null > "$OUT/.probe"; then\n  FALLBACK=1\n  OUT=/tmp/harbor-agent-capture\n  mkdir -p "$OUT"\nfi\nrm -f "$OUT/.probe" 2>/dev/null || true\n\nLOG="$OUT/agent.capture.log"\nexec 2>>"$LOG"\nset -x\n\n# These images ship a repo owned by root; if the hook runs as any other user git\n# refuses with \'dubious ownership\' and exits 128, which looks identical to\n# \'no repo here\'. Allowing every path is safe in a throwaway container.\n#\n# GIT_CONFIG_GLOBAL, because `git config --global` writes $HOME/.gitconfig and on an\n# image whose USER is not root that is the *agent\'s* home - so the hook\'s own side\n# effect was captured as the agent\'s work. Measured on airtable-clone-100-sub1, whose\n# image declares `USER solver`: every trial, control included, reported\n# `home/solver/.gitconfig` as an addition. /tmp is excluded from the diff, and the\n# variable is inherited by every git call below.\nexport GIT_CONFIG_GLOBAL=/tmp/harbor-capture-gitconfig\ngit config --global --add safe.directory \'*\' || true\nid || true\ngit --version || true\n\nROOT=""\nfor d in /app /app/* /workspace /src; do\n  [ -d "$d" ] || continue\n  if git -C "$d" rev-parse --git-dir >/dev/null 2>&1; then ROOT="$d"; break; fi\ndone\nif [ -z "$ROOT" ]; then\n  ROOT=$(dirname "$(find /app /workspace /src -maxdepth 3 -name .git -print -quit 2>/dev/null)" 2>/dev/null)\n  case "$ROOT" in .|"") ROOT="" ;; esac\nfi\n\nif [ -z "$ROOT" ]; then\n  # No repo anywhere. THE BASELINE DIFF IS THE CORRECT ANSWER HERE, and the workdir\n  # snapshot below is the fallback for images it could not be built for.\n  #\n  # prep bakes a manifest of the pristine image into /.harbor-capture at prep time,\n  # next to the script that wrote it. Diffing against that needs no guess about where\n  # the agent worked and cannot attribute a pre-existing file to the agent - which is\n  # what the snapshot did to 45 of 64 sampled batch-4/5 tasks, silently, in a patch\n  # that passed every check. See docs/large-batch4-5-survey-2026-09-15.md 7.1 and\n  # docs/baseline-diff-capture.md.\n  #\n  # Falls through to the snapshot when the image has no python3, or when it predates\n  # this change and carries no manifest - a re-prep is what fixes that, and\n  # `agent.capture_kind` says which path ran so nobody has to guess.\n  #\n  # Note what the baseline measured about the family the snapshot was written for:\n  # airtable-clone-100-sub1\'s `/app` is NOT empty - it ships a five-line stub\n  # `start.sh` ("start.sh not implemented", exit 1) that the reference replaces - and\n  # its image installs `git`. So the snapshot was misattributing that stub to every\n  # model on every clone task, including the delivered ones, and the premise below\n  # was wrong in both halves. See docs/baseline-diff-capture.md 9.\n  BASELINE_DONE=0\n  PY=""\n  for c in python3 python; do\n    command -v "$c" >/dev/null 2>&1 && { PY="$c"; break; }\n  done\n  if [ -n "$PY" ] && [ -f /.harbor-capture/harbor_capture.py ] \\\n     && [ -f /.harbor-capture/manifest.tsv ]; then\n    if "$PY" /.harbor-capture/harbor_capture.py collect --root / \\\n         --store /.harbor-capture --out "$OUT" \\\n         --expect-version 4 >>"$LOG" 2>&1; then\n      BASELINE_DONE=1\n    else\n      echo "baseline capture failed; falling back to the workdir snapshot" >>"$LOG"\n    fi\n  else\n    echo "no baseline manifest in this image; using the workdir snapshot" >>"$LOG"\n  fi\n\n  SNAP=""\n  for d in /app /workspace /src; do [ -d "$d" ] && { SNAP="$d"; break; }; done\n  if [ "$BASELINE_DONE" = 1 ]; then\n    :\n  elif [ -z "$SNAP" ]; then\n    { echo "no git repo and no workdir to snapshot"; ls -a / 2>&1 | head -40; } \\\n      > "$OUT/agent.patch.error"\n  else\n    echo "snapshot" > "$OUT/agent.capture_kind"\n    echo "$SNAP" > "$OUT/agent.snapshot_root"\n    # The manifest is the complete answer even where the diff is not: a binary or an\n    # over-large file appears here with its size and is skipped below, so "what did\n    # the agent produce" is never silently short.\n    # Space-separated rather than tab: a tab has to be written as an escape, and an\n    # escape inside this string is one Python-vs-shell quoting mistake away from a\n    # literal backslash-t in the output or, worse, a real newline that splits the\n    # command. Sizes never contain a space, so "size path" still parses.\n    ( cd "$SNAP" && find . -type f -exec stat -c \'%s %n\' {} + 2>/dev/null ) \\\n      | sed \'s| \\./| |\' | sort -k2 > "$OUT/agent.tree"\n    : > "$OUT/agent.patch"\n    ( cd "$SNAP" && find . -type f | sed \'s|^\\./||\' | sort ) | while IFS= read -r f; do\n      [ -n "$f" ] || continue\n      case "$f" in .git/*|*/.git/*) continue ;; esac\n      sz=$(wc -c < "$SNAP/$f" 2>/dev/null || echo 0)\n      # 256 KiB, and text only. A snapshot\'s job is to show an annotator what was\n      # written, not to be a faithful archive - the whole tree is in the task zip.\n      [ "${sz:-0}" -gt 262144 ] && continue\n      grep -Iq . "$SNAP/$f" 2>/dev/null || continue\n      n=$(wc -l < "$SNAP/$f" 2>/dev/null || echo 0)\n      # The real mode, not a guess. Whether the agent remembered to make start.sh\n      # executable is exactly the kind of thing an annotator is looking for.\n      mode=$(stat -c \'%a\' "$SNAP/$f" 2>/dev/null || echo 644)\n      case "$mode" in *[!0-7]*|"") mode=644 ;; esac\n      {\n        echo "diff --git a/$f b/$f"\n        echo "new file mode 100$mode"\n        echo "--- /dev/null"\n        echo "+++ b/$f"\n        echo "@@ -0,0 +1,${n:-0} @@"\n        sed \'s/^/+/\' "$SNAP/$f"\n      } >> "$OUT/agent.patch"\n    done\n    echo "snapshot of $SNAP: $(wc -l < "$OUT/agent.tree") file(s)" >> "$LOG"\n  fi\nelse\n  echo "$ROOT" > "$OUT/agent.repo_root"\n  git -C "$ROOT" add -A -N || true\n\n  # WHAT TO DIFF AGAINST, and it is not HEAD.\n  #\n  # `` is the commit the *pristine image* sat on, read out of the\n  # image by `baseline_probe` before the agent ever ran. HEAD is not a safe stand-in\n  # for it: batch 3\'s tasks tell the agent to COMMIT its work ("only committed work is\n  # graded"), and `solution/solve.sh` commits too - so by the time this hook runs, HEAD\n  # already contains everything the agent did and `git diff HEAD` is empty. Two tasks\n  # with a perfect three-trial oracle were filed as `patch_capture_broken` on\n  # 2026-09-15 on exactly that empty diff.\n  #\n  # Falls back to HEAD when no base was probed, which is the pre-2026-09-15 behaviour\n  # and correct wherever the agent does not commit (all of batch 1 and 2: there HEAD\n  # *is* the pristine commit). `agent.diff_base` records which was used, because "what\n  # was this diffed against" is not a question to answer by re-reading the hook.\n  BASE=""\n  DIFF_FROM=HEAD\n  if [ -n "$BASE" ] && git -C "$ROOT" rev-parse --verify --quiet "$BASE^{commit}" >/dev/null 2>&1; then\n    DIFF_FROM="$BASE"\n  fi\n  echo "$DIFF_FROM" > "$OUT/agent.diff_base"\n\n  # Diff against a commit, not the index. `add -A -N` marks new files intent-to-add but\n  # *stages* deletions, so a bare `git diff` (index vs worktree) sees index and\n  # worktree agreeing about a deleted file and omits it entirely - silently losing\n  # every deletion from the patch. Diffing a commit covers modifications, additions\n  # and deletions together.\n  git -C "$ROOT" diff --binary "$DIFF_FROM" > "$OUT/agent.patch" || true\n  git -C "$ROOT" status --porcelain > "$OUT/agent.status" || true\n  git -C "$ROOT" diff --stat "$DIFF_FROM" > "$OUT/agent.diffstat" || true\n  git -C "$ROOT" log --oneline "$DIFF_FROM"..HEAD > "$OUT/agent.commits" 2>/dev/null || true\nfi\necho "capture finished, patch bytes: $(wc -c < "$OUT/agent.patch" 2>/dev/null || echo none)" >> "$LOG"\n\n# /logs was unwritable, so nothing above will be collected. Hand the diff to harbor\n# through stdout instead, and exit non-zero so harbor actually logs it - on a zero exit\n# it logs "completed" and discards the output. `run_agents.recover_patch_from_log` reads\n# it back out of trial.log. Tracing goes to $LOG, not stderr, so it cannot land between\n# the sentinels: harbor merges stderr into stdout.\nif [ "$FALLBACK" = 1 ]; then\n  set +x\n  echo "HARBOR_PIPELINE_PATCH_FALLBACK_BEGIN"\n  cat "$OUT/agent.patch" 2>/dev/null || true\n  echo ""\n  echo "HARBOR_PIPELINE_PATCH_FALLBACK_END"\n  echo "capture wrote to $OUT because /logs was unwritable; diff emitted on stdout" >&2\n  exit 1\nfi\n'
