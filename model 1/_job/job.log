Sending keys: ['cat > stages/aggregation.py << \'EOF\'\nimport json\nfrom stages.cctf import decode_frames\n\n\ndef aggregate_metrics(metrics_file: str, config: dict) -> list:\n    with open(metrics_file, "rb") as f:\n        data = f.read()\n    frames = decode_frames(data)\n    mc = config["metric_config"]\n    whitelist = mc["whitelisted_attributes"]\n    interval = mc["aggregation_interval_hours"] * 3600\n    groups = {}\n    for version, ftype, seq, payload in frames:\n        if ftype != 2:\n            continue\n        rec = json.loads(payload.decode("utf-8"))\n        if "metric_name" not in rec or "timestamp" not in rec or "value" not in rec:\n            continue\n        attrs = rec.get("attributes", {})\n        filtered = {k: v for k, v in attrs.items() if k in whitelist}\n        ts = rec["timestamp"]\n        bucket = ts - (ts % interval)\n        akey = json.dumps(filtered, sort_keys=True)\n        key = (rec["metric_name"], bucket, akey)\n        if key not in groups:\n            groups[key] = {"sum": 0.0, "count": 0, "attrs": filtered}\n        groups[key]["sum"] += rec["value"]\n        groups[key]["count"] += 1\n    out = []\n    for (mname, bucket, akey), g in groups.items():\n        mean = round(g["sum"] / g["count"], 4)\n        out.append({"metric_name": mname, "timestamp": bucket,\n                    "value": mean, "attributes": g["attrs"]})\n    out.sort(key=lambda r: (r["metric_name"], r["timestamp"],\n                            json.dumps(r["attributes"], sort_keys=True)))\n    return out\nEOF\necho done\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
