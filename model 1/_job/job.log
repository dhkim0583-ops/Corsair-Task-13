Sending keys: ['cat > stages/cctf.py << \'EOF\'\nimport struct\nimport zlib\nimport json\n\n\ndef decode_frames(data: bytes):\n    """Yield decoded frames (version, ftype, seq, payload_bytes) up to the\n    first invalid frame. Stops at corruption boundary."""\n    frames = []\n    off = 0\n    chain = 0\n    n = len(data)\n    while True:\n        if off + 10 > n:\n            break\n        if data[off:off + 2] != b"CC":\n            break\n        version = data[off + 2]\n        ftype = data[off + 3]\n        seq = struct.unpack(">I", data[off + 4:off + 8])[0]\n        plen = struct.unpack(">H", data[off + 8:off + 10])[0]\n        if off + 10 + plen + 8 > n:\n            break\n        payload = data[off + 10:off + 10 + plen]\n        stored_crc = struct.unpack(">I", data[off + 10 + plen:off + 14 + plen])[0]\n        stored_chain = struct.unpack(">I", data[off + 14 + plen:off + 18 + plen])[0]\n        crc = zlib.crc32(data[off:off + 10 + plen]) & 0xFFFFFFFF\n        if crc != stored_crc:\n            break\n        new_chain = zlib.crc32(struct.pack(">I", chain) + struct.pack(">I", crc)) & 0xFFFFFFFF\n        if new_chain != stored_chain:\n            break\n        chain = new_chain\n        frames.append((version, ftype, seq, payload))\n        off += 18 + plen\n    return frames\n\n\ndef migrate_temp(record: dict, version, config: dict):\n    sv = config["schema_versions"][str(version)]\n    field = sv["temperature_field"]\n    scale = sv["scale"]\n    if field in record:\n        val = record.pop(field)\n        if scale == "deci_celsius":\n            val = val / 10.0\n        else:\n            val = float(val)\n        record["temperature_c"] = val\n    return record\n\n\ndef recover_committed(data: bytes, config: dict):\n    """Run the transactional state machine over decoded frames, returning the\n    list of committed records (temperature migrated)."""\n    frames = decode_frames(data)\n    committed = []\n    pending = []\n    savepoints = {}\n    for version, ftype, seq, payload in frames:\n        if ftype == 1:  # TXN\n            rec = json.loads(payload.decode("utf-8"))\n            rec = migrate_temp(rec, version, config)\n            pending.append(rec)\n        elif ftype == 5:  # SAVEPOINT\n            obj = json.loads(payload.decode("utf-8"))\n            savepoints[obj["savepoint"]] = len(pending)\n        elif ftype == 6:  # ROLLBACK\n            obj = json.loads(payload.decode("utf-8"))\n            name = obj["savepoint"]\n            if name in savepoints:\n                target = savepoints[name]\n                pending = pending[:target]\n                savepoints = {k: v for k, v in savepoints.items() if v <= target}\n        elif ftype == 3:  # COMMIT\n            committed.extend(pending)\n            pending = []\n            savepoints = {}\n        elif ftype == 4:  # ABORT\n            pending = []\n            savepoints = {}\n    return committed\nEOF\necho done\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
