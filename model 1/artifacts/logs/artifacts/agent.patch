+import os
+import re
+import json
+from stages.cctf import recover_committed
+
+
+def _read(path):
+    with open(path, "rb") as f:
+        return f.read()
+
+
+def recover_ledgers(data_dir: str, output_dir: str, config: dict = None) -> dict:
+    os.makedirs(output_dir, exist_ok=True)
+    ids = {}
+    for name in os.listdir(data_dir):
+        m = re.match(r"scanner_(.+)\.cctf(\.tmp)?$", name)
+        if not m:
+            continue
+        ids.setdefault(m.group(1), []).append(name)
+    audit = {}
+    for sid in sorted(ids):
+        merged = {}
+        order = []
+        for name in sorted(ids[sid]):
+            path = os.path.join(data_dir, name)
+            recs = recover_committed(_read(path), config)
+            for r in recs:
+                tid = r.get("transaction_id")
+                if tid in merged:
+                    if r.get("timestamp", 0) > merged[tid].get("timestamp", 0):
+                        merged[tid] = r
+                else:
+                    merged[tid] = r
+                    order.append(tid)
+        result = [merged[t] for t in order]
+        with open(os.path.join(output_dir, "recovered_%s.json" % sid), "w") as f:
+            json.dump(result, f, indent=2)
+        audit[sid] = len(result)
+    with open(os.path.join(output_dir, "audit_recovery.json"), "w") as f:
+        json.dump(audit, f, indent=2)
+    return audit
