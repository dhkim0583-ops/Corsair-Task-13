+import json
+from stages.cctf import decode_frames
+
+
 def aggregate_metrics(metrics_file: str, config: dict) -> list:
-    """
-    Processes OpenTelemetry metrics, filters out non-whitelisted attributes,
-    and aggregates them into hourly windows.
-    """
-    raise NotImplementedError("Stage 2: aggregate_metrics is not implemented yet.")
+    with open(metrics_file, "rb") as f:
+        data = f.read()
+    frames = decode_frames(data)
+    mc = config["metric_config"]
+    whitelist = mc["whitelisted_attributes"]
+    interval = mc["aggregation_interval_hours"] * 3600
+    groups = {}
+    for version, ftype, seq, payload in frames:
+        if ftype != 2:
+            continue
+        rec = json.loads(payload.decode("utf-8"))
+        if "metric_name" not in rec or "timestamp" not in rec or "value" not in rec:
+            continue
+        attrs = rec.get("attributes", {})
+        filtered = {k: v for k, v in attrs.items() if k in whitelist}
+        ts = rec["timestamp"]
+        bucket = ts - (ts % interval)
+        akey = json.dumps(filtered, sort_keys=True)
+        key = (rec["metric_name"], bucket, akey)
+        if key not in groups:
+            groups[key] = {"sum": 0.0, "count": 0, "attrs": filtered}
+        groups[key]["sum"] += rec["value"]
+        groups[key]["count"] += 1
+    out = []
+    for (mname, bucket, akey), g in groups.items():
+        mean = round(g["sum"] / g["count"], 4)
+        out.append({"metric_name": mname, "timestamp": bucket,
+                    "value": mean, "attributes": g["attrs"]})
+    out.sort(key=lambda r: (r["metric_name"], r["timestamp"],
+                            json.dumps(r["attributes"], sort_keys=True)))
+    return out
