-def consolidate_and_checksum(all_records: list, output_path: str, root_path: str, sig_path: str) -> str:
-    """
-    Canonicalizes and sorts all records, writing the consolidated ledger to output_path.
-    Computes the order-dependent chained SHA-256 root (written to root_path) and the
-    record-count-derived HMAC-SHA256 signature (written to sig_path).
-    Returns the hex string of the chained root.
-    """
-    raise NotImplementedError("Stage 4: consolidate_and_checksum is not implemented yet.")
+import json
+import hashlib
+import hmac
+
+
+def consolidate_and_checksum(all_records: list, output_path: str,
+                             root_path: str, sig_path: str) -> str:
+    records = sorted(all_records, key=lambda r: (
+        str(r.get("scanner_id", "")),
+        r.get("sequence", 0),
+        r.get("timestamp", 0),
+    ))
+    with open(output_path, "w") as f:
+        json.dump(records, f, indent=2)
+    state = hashlib.sha256(b"CCTF-ROOT-V1").digest()
+    for r in records:
+        proj = {
+            "transaction_id": r.get("transaction_id"),
+            "scanner_id": r.get("scanner_id"),
+            "sequence": r.get("sequence"),
+            "timestamp": r.get("timestamp"),
+            "temperature_c": round(r.get("temperature_c"), 2),
+        }
+        pbytes = json.dumps(proj, separators=(",", ":"), sort_keys=True).encode("utf-8")
+        state = hashlib.sha256(state + pbytes).digest()
+    root = state
+    with open(root_path, "wb") as f:
+        f.write(root)
+    n = len(records)
+    key = hashlib.sha256(b"coldchain-fleet|" + str(n).encode("utf-8")).digest()
+    sig = hmac.new(key, root, hashlib.sha256).digest()
+    with open(sig_path, "wb") as f:
+        f.write(sig)
+    return root.hex()
