new file mode 100644
--- /dev/null
+++ b/workspace/coldchain-recon/stages/cctf.py
@@ -0,0 +1,82 @@
+import struct
+import zlib
+import json
+
+
+def decode_frames(data: bytes):
+    """Yield decoded frames (version, ftype, seq, payload_bytes) up to the
+    first invalid frame. Stops at corruption boundary."""
+    frames = []
+    off = 0
+    chain = 0
+    n = len(data)
+    while True:
+        if off + 10 > n:
+            break
+        if data[off:off + 2] != b"CC":
+            break
+        version = data[off + 2]
+        ftype = data[off + 3]
+        seq = struct.unpack(">I", data[off + 4:off + 8])[0]
+        plen = struct.unpack(">H", data[off + 8:off + 10])[0]
+        if off + 10 + plen + 8 > n:
+            break
+        payload = data[off + 10:off + 10 + plen]
+        stored_crc = struct.unpack(">I", data[off + 10 + plen:off + 14 + plen])[0]
+        stored_chain = struct.unpack(">I", data[off + 14 + plen:off + 18 + plen])[0]
+        crc = zlib.crc32(data[off:off + 10 + plen]) & 0xFFFFFFFF
+        if crc != stored_crc:
+            break
+        new_chain = zlib.crc32(struct.pack(">I", chain) + struct.pack(">I", crc)) & 0xFFFFFFFF
+        if new_chain != stored_chain:
+            break
+        chain = new_chain
+        frames.append((version, ftype, seq, payload))
+        off += 18 + plen
+    return frames
+
+
+def migrate_temp(record: dict, version, config: dict):
+    sv = config["schema_versions"][str(version)]
+    field = sv["temperature_field"]
+    scale = sv["scale"]
+    if field in record:
+        val = record.pop(field)
+        if scale == "deci_celsius":
+            val = val / 10.0
+        else:
+            val = float(val)
+        record["temperature_c"] = val
+    return record
+
+
+def recover_committed(data: bytes, config: dict):
+    """Run the transactional state machine over decoded frames, returning the
+    list of committed records (temperature migrated)."""
+    frames = decode_frames(data)
+    committed = []
+    pending = []
+    savepoints = {}
+    for version, ftype, seq, payload in frames:
+        if ftype == 1:  # TXN
+            rec = json.loads(payload.decode("utf-8"))
+            rec = migrate_temp(rec, version, config)
+            pending.append(rec)
+        elif ftype == 5:  # SAVEPOINT
+            obj = json.loads(payload.decode("utf-8"))
+            savepoints[obj["savepoint"]] = len(pending)
+        elif ftype == 6:  # ROLLBACK
+            obj = json.loads(payload.decode("utf-8"))
+            name = obj["savepoint"]
+            if name in savepoints:
+                target = savepoints[name]
+                pending = pending[:target]
+                savepoints = {k: v for k, v in savepoints.items() if v <= target}
+        elif ftype == 3:  # COMMIT
+            committed.extend(pending)
+            pending = []
+            savepoints = {}
+        elif ftype == 4:  # ABORT
+            pending = []
+            savepoints = {}
+    return committed
