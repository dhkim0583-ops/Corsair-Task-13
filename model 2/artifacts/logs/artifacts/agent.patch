+import os
+import json
+import struct
+import zlib
+
+def recover_ledgers(data_dir, output_dir, config):
+    schema_versions = config.get("schema_versions", {})
+    all_recovered = {}
+    audit_log = {"files_processed": 0, "frames_recovered": 0}
+
+    # Find all scanner files
+    files = [f for f in os.listdir(data_dir) if f.startswith("scanner_") and (f.endswith(".cctf") or f.endswith(".cctf.tmp"))]
+    
+    for filename in files:
+        scanner_id = filename.split('_')[2].split('.')[0]
+        path = os.path.join(data_dir, filename)
+        
+        records = []
+        pending = []
+        savepoints = {}
+        
+        with open(path, "rb") as f:
+            chain = 0
+            seq = 0
+            while True:
+                header = f.read(10)
+                if len(header) < 10: break
+                if header[0:2] != b"CC": break
+                
+                version = header[2]
+                ftype = header[3]
+                fseq = struct.unpack(">I", header[4:8])[0]
+                plen = struct.unpack(">H", header[8:10])[0]
+                
+                payload_data = f.read(plen)
+                footer = f.read(8)
+                if len(footer) < 8: break
+                
+                crc_stored = struct.unpack(">I", footer[0:4])[0]
+                chain_stored = struct.unpack(">I", footer[4:8])[0]
+                
+                # CRC validation
+                data_to_crc = header + payload_data
+                crc_calc = zlib.crc32(data_to_crc) & 0xFFFFFFFF
+                if crc_calc != crc_stored: break
+                
+                # Chain validation
+                # chain_i = zlib.crc32(struct.pack(">I", chain_{i-1}) + struct.pack(">I", crc_i))
+                chain_calc = zlib.crc32(struct.pack(">I", chain) + struct.pack(">I", crc_calc)) & 0xFFFFFFFF
+                if chain_calc != chain_stored: break
+                chain = chain_calc
+                
+                # Process payload
+                try:
+                    payload = json.loads(payload_data.decode("utf-8")) if plen > 0 else {}
+                except:
+                    break
+                
+                if ftype == 1: # TXN
+                    # Migrate schema
+                    schema = schema_versions.get(str(version), {})
+                    field = schema.get("temperature_field")
+                    val = payload.get(field)
+                    if schema.get("scale") == "deci_celsius":
+                        val = val / 10.0
+                    payload["temperature_c"] = val
+                    payload["scanner_id"] = scanner_id
+                    pending.append(payload)
+                elif ftype == 5: # SAVEPOINT
+                    savepoints[payload.get("savepoint")] = len(pending)
+                elif ftype == 6: # ROLLBACK
+                    name = payload.get("savepoint")
+                    if name in savepoints:
+                        idx = savepoints[name]
+                        pending = pending[:idx]
+                        savepoints = {k: v for k, v in savepoints.items() if v <= idx}
+                elif ftype == 3: # COMMIT
+                    records.extend(pending)
+                    pending = []
+                    savepoints = {}
+                elif ftype == 4: # ABORT
+                    pending = []
+                    savepoints = {}
+                    
+        all_recovered[scanner_id] = records
+        audit_log["files_processed"] += 1
+        audit_log["frames_recovered"] += len(records)
+        
+        with open(os.path.join(output_dir, f"recovered_{scanner_id}.json"), "w") as out:
+            json.dump(records, out, indent=2)
+
+    with open(os.path.join(output_dir, "audit_recovery.json"), "w") as out:
+        json.dump(audit_log, out, indent=2)
+        
+    return all_recovered
