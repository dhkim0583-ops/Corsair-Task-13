+    all_records = {}
+    for f in os.listdir(recovered_dir):
+        if f.startswith("recovered_") and f.endswith(".json"):
+            scanner_id = f[10:-5]
+            with open(os.path.join(recovered_dir, f), "r") as r:
+                all_records[scanner_id] = {rec["transaction_id"]: rec for rec in json.load(r)}
