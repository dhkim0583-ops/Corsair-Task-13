+        if scanner_id not in all_records:
+            all_records[scanner_id] = {}
+        
+        for rec in records:
+            tid = rec["transaction_id"]
+            if tid in all_records[scanner_id]:
+                existing = all_records[scanner_id][tid]
+                drift = abs(rec["timestamp"] - existing["timestamp"])
+                if drift > config["lock_timeout_sec"]:
+                    all_records[scanner_id][tid] = rec
+                    audit["integrated_dlq_records"] += 1
+                else:
+                    audit["discarded_duplicates"] += 1
+            else:
+                all_records[scanner_id][tid] = rec
+                audit["integrated_dlq_records"] += 1
+                
+    flat_records = []
+    for scanner_id in all_records:
