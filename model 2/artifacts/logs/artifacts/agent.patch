+import json
+import hashlib
+import hmac
+
+def consolidate_and_checksum(all_records, output_path, root_path, sig_path):
+    all_records.sort(key=lambda x: (x["scanner_id"], x["sequence"], x["timestamp"]))
+    
+    with open(output_path, "w") as f:
+        json.dump(all_records, f, indent=2)
+        
+    state = hashlib.sha256(b"CCTF-ROOT-V1").digest()
+    for rec in all_records:
+        proj = {
+            "transaction_id": rec["transaction_id"],
+            "scanner_id": rec["scanner_id"],
+            "sequence": rec["sequence"],
+            "timestamp": rec["timestamp"],
+            "temperature_c": round(rec["temperature_c"], 2)
+        }
+        proj_bytes = json.dumps(proj, separators=(",", ":"), sort_keys=True).encode("utf-8")
+        state = hashlib.sha256(state + proj_bytes).digest()
+        
+    with open(root_path, "wb") as f:
+        f.write(state)
+        
+    N = len(all_records)
+    key = hashlib.sha256(b"coldchain-fleet|" + str(N).encode("utf-8")).digest()
+    sig = hmac.new(key, state, hashlib.sha256).digest()
+    
+    with open(sig_path, "wb") as f:
+        f.write(sig)
+        
+    return state.hex()
