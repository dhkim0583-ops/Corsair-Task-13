Sending keys: ['cat > stages/replay.py << \'EOF\'\nimport os\nimport json\nfrom stages.recovery import recover_ledgers\n\ndef replay_dead_letters(recovered_dir, dlq_dir, config):\n    all_records = {}\n    for f in os.listdir(recovered_dir):\n        if f.startswith("recovered_") and f.endswith(".json"):\n            scanner_id = f[10:-5]\n            with open(os.path.join(recovered_dir, f), "r") as r:\n                all_records[scanner_id] = {rec["transaction_id"]: rec for rec in json.load(r)}\n\n    dlq_records = recover_ledgers(dlq_dir, dlq_dir, config)\n    \n    audit = {"integrated_dlq_records": 0, "discarded_duplicates": 0}\n    \n    for scanner_id, records in dlq_records.items():\n        if scanner_id not in all_records:\n            all_records[scanner_id] = {}\n        \n        for rec in records:\n            tid = rec["transaction_id"]\n            if tid in all_records[scanner_id]:\n                existing = all_records[scanner_id][tid]\n                drift = abs(rec["timestamp"] - existing["timestamp"])\n                if drift > config["lock_timeout_sec"]:\n                    all_records[scanner_id][tid] = rec\n                    audit["integrated_dlq_records"] += 1\n                else:\n                    audit["discarded_duplicates"] += 1\n            else:\n                all_records[scanner_id][tid] = rec\n                audit["integrated_dlq_records"] += 1\n                \n    flat_records = []\n    for scanner_id in all_records:\n        flat_records.extend(all_records[scanner_id].values())\n        \n    return flat_records, audit\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ['cat > stages/consolidation.py << \'EOF\'\nimport json\nimport hashlib\nimport hmac\n\ndef consolidate_and_checksum(all_records, output_path, root_path, sig_path):\n    all_records.sort(key=lambda x: (x["scanner_id"], x["sequence"], x["timestamp"]))\n    \n    with open(output_path, "w") as f:\n        json.dump(all_records, f, indent=2)\n        \n    state = hashlib.sha256(b"CCTF-ROOT-V1").digest()\n    for rec in all_records:\n        proj = {\n            "transaction_id": rec["transaction_id"],\n            "scanner_id": rec["scanner_id"],\n            "sequence": rec["sequence"],\n            "timestamp": rec["timestamp"],\n            "temperature_c": round(rec["temperature_c"], 2)\n        }\n        proj_bytes = json.dumps(proj, separators=(",", ":"), sort_keys=True).encode("utf-8")\n        state = hashlib.sha256(state + proj_bytes).digest()\n        \n    with open(root_path, "wb") as f:\n        f.write(state)\n        \n    N = len(all_records)\n    key = hashlib.sha256(b"coldchain-fleet|" + str(N).encode("utf-8")).digest()\n    sig = hmac.new(key, state, hashlib.sha256).digest()\n    \n    with open(sig_path, "wb") as f:\n        f.write(sig)\n        \n    return state.hex()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
