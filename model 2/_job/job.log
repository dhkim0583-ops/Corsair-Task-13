Sending keys: ['cat > stages/recovery.py << \'EOF\'\nimport os\nimport json\nimport struct\nimport zlib\n\ndef recover_ledgers(data_dir, output_dir, config):\n    schema_versions = config.get("schema_versions", {})\n    all_recovered = {}\n    audit_log = {"files_processed": 0, "frames_recovered": 0}\n\n    # Find all scanner files\n    files = [f for f in os.listdir(data_dir) if f.startswith("scanner_") and (f.endswith(".cctf") or f.endswith(".cctf.tmp"))]\n    \n    for filename in files:\n        scanner_id = filename.split(\'_\')[2].split(\'.\')[0]\n        path = os.path.join(data_dir, filename)\n        \n        records = []\n        pending = []\n        savepoints = {}\n        \n        with open(path, "rb") as f:\n            chain = 0\n            seq = 0\n            while True:\n                header = f.read(10)\n                if len(header) < 10: break\n                if header[0:2] != b"CC": break\n                \n                version = header[2]\n                ftype = header[3]\n                fseq = struct.unpack(">I", header[4:8])[0]\n                plen = struct.unpack(">H", header[8:10])[0]\n                \n                payload_data = f.read(plen)\n                footer = f.read(8)\n                if len(footer) < 8: break\n                \n                crc_stored = struct.unpack(">I", footer[0:4])[0]\n                chain_stored = struct.unpack(">I", footer[4:8])[0]\n                \n                # CRC validation\n                data_to_crc = header + payload_data\n                crc_calc = zlib.crc32(data_to_crc) & 0xFFFFFFFF\n                if crc_calc != crc_stored: break\n                \n                # Chain validation\n                # chain_i = zlib.crc32(struct.pack(">I", chain_{i-1}) + struct.pack(">I", crc_i))\n                chain_calc = zlib.crc32(struct.pack(">I", chain) + struct.pack(">I", crc_calc)) & 0xFFFFFFFF\n                if chain_calc != chain_stored: break\n                chain = chain_calc\n                \n                # Process payload\n                try:\n                    payload = json.loads(payload_data.decode("utf-8")) if plen > 0 else {}\n                except:\n                    break\n                \n                if ftype == 1: # TXN\n                    # Migrate schema\n                    schema = schema_versions.get(str(version), {})\n                    field = schema.get("temperature_field")\n                    val = payload.get(field)\n                    if schema.get("scale") == "deci_celsius":\n                        val = val / 10.0\n                    payload["temperature_c"] = val\n                    payload["scanner_id"] = scanner_id\n                    pending.append(payload)\n                elif ftype == 5: # SAVEPOINT\n                    savepoints[payload.get("savepoint")] = len(pending)\n                elif ftype == 6: # ROLLBACK\n                    name = payload.get("savepoint")\n                    if name in savepoints:\n                        idx = savepoints[name]\n                        pending = pending[:idx]\n                        savepoints = {k: v for k, v in savepoints.items() if v <= idx}\n                elif ftype == 3: # COMMIT\n                    records.extend(pending)\n                    pending = []\n                    savepoints = {}\n                elif ftype == 4: # ABORT\n                    pending = []\n                    savepoints = {}\n                    \n        all_recovered[scanner_id] = records\n        audit_log["files_processed"] += 1\n        audit_log["frames_recovered"] += len(records)\n        \n        with open(os.path.join(output_dir, f"recovered_{scanner_id}.json"), "w") as out:\n            json.dump(records, out, indent=2)\n\n    with open(os.path.join(output_dir, "audit_recovery.json"), "w") as out:\n        json.dump(audit_log, out, indent=2)\n        \n    return all_recovered\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
