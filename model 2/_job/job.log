Sending keys: ['cat > stages/aggregation.py << \'EOF\'\nimport json\nimport collections\n\ndef aggregate_metrics(metrics_file, config, output_dir):\n    interval = config["metric_config"]["aggregation_interval_hours"]\n    whitelist = set(config["metric_config"]["whitelisted_attributes"])\n    \n    # Need to reuse recovery logic to parse metrics.cctf\n    from stages.recovery import recover_ledgers\n    # Create a dummy output dir for recovery\n    import tempfile\n    import os\n    with tempfile.TemporaryDirectory() as tmpdir:\n        # We only need the recovery logic for metrics.cctf\n        # We\'ll just run it on the metrics file\n        os.makedirs(os.path.join(tmpdir, "data"))\n        import shutil\n        shutil.copy(metrics_file, os.path.join(tmpdir, "data", "scanner_metrics.cctf"))\n        recovered = recover_ledgers(os.path.join(tmpdir, "data"), tmpdir, config)\n    \n    metrics = recovered.get("metrics", [])\n    \n    grouped = collections.defaultdict(list)\n    for m in metrics:\n        ts = m.get("timestamp", 0)\n        bucket = ts - (ts % (interval * 3600))\n        attrs = {k: v for k, v in m.items() if k in whitelist}\n        key = (m.get("metric_name"), bucket, json.dumps(attrs, sort_keys=True))\n        grouped[key].append(m.get("value", 0))\n        \n    results = []\n    for (name, bucket, attrs_str), values in grouped.items():\n        results.append({\n            "metric_name": name,\n            "timestamp": bucket,\n            "value": round(sum(values) / len(values), 4),\n            "attributes": json.loads(attrs_str)\n        })\n        \n    results.sort(key=lambda x: (x["metric_name"], x["timestamp"], json.dumps(x["attributes"], sort_keys=True)))\n    \n    with open(os.path.join(output_dir, "aggregated_metrics.json"), "w") as f:\n        json.dump(results, f, indent=2)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
